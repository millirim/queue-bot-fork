#!/usr/bin/env bash
# Управление ботом на сервере. Справка: queue-bot help
set -euo pipefail

# Весь код — внутри функции: bash прочитает её целиком, и обновление этого же файла
# посреди работы (git reset в update) ничего не сломает.
main() {
    source /opt/queue-bot/deploy/common.sh
    local cmd="${1:-help}"
    case "$cmd" in
        update)  need_root queue-bot update; update ;;
        update-from-bot) need_root queue-bot update-from-bot; update_from_bot ;;
        status)  systemctl status queue-bot --no-pager -n 0 || true; echo; echo "Версия: $(version)" ;;
        logs)    journalctl -u queue-bot -f -n 50 ;;
        restart) need_root queue-bot restart
                 restart_and_check && say "Бот перезапущен ✓" || die "Бот не запустился: queue-bot logs" ;;
        stop)    need_root queue-bot stop; systemctl stop queue-bot; systemctl stop queue-bot-maint 2>/dev/null || true
                 say "Бот остановлен (дежурный ответчик тоже: пока не запустишь, люди без ответа)" ;;
        start)   need_root queue-bot start; systemctl start queue-bot; say "Бот запущен" ;;
        backup)  need_root queue-bot backup; systemctl start queue-bot-backup.service
                 journalctl -u queue-bot-backup -n 1 -o cat --no-pager ;;
        config)  need_root queue-bot config; "${EDITOR:-nano}" "$CONF"
                 restart_and_check && say "Настройки применены ✓" || die "Бот не запустился: queue-bot logs" ;;
        games)   case "${2:-status}" in
                     status)  systemctl status queue-bot-games --no-pager -n 0 || true ;;
                     logs)    journalctl -u queue-bot-games -f -n 50 ;;
                     restart) need_root queue-bot games restart; systemctl restart queue-bot-games; say "Игры перезапущены ✓" ;;
                     *) echo "queue-bot games [status|logs|restart]" ;;
                 esac ;;
        version) version ;;
        *) cat <<HELP
queue-bot — управление ботом очереди

  sudo queue-bot update    обновить из GitHub (бэкап базы, откат, если не запустился)
                           то же делает кнопка «🔄 Обновить бота» в Панели Админа
  queue-bot status         работает ли бот и какая версия
  queue-bot logs           логи в реальном времени (выход — Ctrl+C)
  queue-bot games [status|logs|restart]   отдельная служба игр (её сбой не задевает бота)
  sudo queue-bot restart   перезапустить
  sudo queue-bot stop      остановить        sudo queue-bot start   запустить
  sudo queue-bot backup    сделать бэкап базы сейчас
  sudo queue-bot config    изменить токен/админов (откроется редактор)

Где что лежит:
  код        $CODE
  настройки  $CONF
  база       $DATA/queue.db   (бэкапы — $DATA/backups)
HELP
        ;;
    esac
}

update() {
    cd "$CODE"
    say "Проверяю обновления"
    git fetch -q origin
    local old new
    old=$(git rev-parse HEAD)
    new=$(git rev-parse '@{u}')
    if [[ $old == "$new" ]]; then
        # Код тот же, но службы приводим в порядок: так после обновления со старой версии команды queue-bot
        # (она не знала про новые службы) второй запуск update включает всё недостающее, например кнопку в боте.
        apply_code
        echo "Уже последняя версия: $(version)"
        return
    fi
    echo "Что нового:"
    git log --format='  • %s' --no-merges "$old..$new"

    say "Бэкап базы"
    systemctl start queue-bot-backup.service || echo "⚠️  Бэкап не удался — продолжаю"

    say "Обновляю"
    git reset -q --hard "$new"
    apply_code
    if restart_and_check; then
        say "Готово ✓ Версия: $(version). Настройки и база не тронуты."
        return
    fi
    journalctl -u queue-bot -n 30 --no-pager || true
    say "Новая версия не запустилась — возвращаю прошлую"
    git reset -q --hard "$old"
    apply_code
    restart_and_check || true
    die "Обновление отменено, работает прошлая версия. Пришли лог выше разработчику."
}

# Обновление по запросу от бота (кнопка в Панели Админа). Запускает systemd (queue-bot-update.service) от root.
# Делает то же, что update, и кладёт итог в $DATA/update-result — бот перешлёт его админу в чат.
update_from_bot() {
    local req="$DATA/update-request" running="$DATA/update-running" result="$DATA/update-result"
    local chat_id old new out rc status
    # Кто просил — только число; всё остальное из файла игнорируется.
    chat_id=$("$CODE/.venv/bin/python" -I -c '
import json, sys
try:
    value = json.load(open(sys.argv[1]))["chat_id"]
    print(value if isinstance(value, int) and not isinstance(value, bool) else "")
except Exception:
    print("")' "$req" 2>/dev/null || true)
    rm -f "$req"                        # сразу: иначе systemd запустил бы обновление снова
    : > "$running"; chown "$APP_USER:$APP_USER" "$running"
    # Путь подставляется сразу, в двойных кавычках: к концу работы локальной переменной $running уже не будет.
    trap "rm -f '$running'" EXIT

    old=$(version)
    set +e
    out=$(update 2>&1)                  # die() внутри завершает только эту подоболочку
    rc=$?
    set -e
    new=$(version)
    out=$(printf '%s' "$out" | sed 's/\x1b\[[0-9;]*m//g')

    if [[ $rc -ne 0 ]]; then status=failed
    elif grep -q 'Уже последняя версия' <<<"$out"; then status=same
    else status=ok; fi

    STATUS=$status OLD=$old NEW=$new CHAT_ID=$chat_id OUT=$out RESULT=$result "$CODE/.venv/bin/python" -I -c '
import json, os
out = os.environ["OUT"].splitlines()
data = {
    "status": os.environ["STATUS"],
    "old_version": os.environ["OLD"],
    "version": os.environ["NEW"],
    "chat_id": int(os.environ["CHAT_ID"]) if os.environ["CHAT_ID"].isdigit() else None,
    "changes": [l[4:] for l in out if l.startswith("  • ")][:15],
    "tail": "\n".join(out[-12:]),
}
with open(os.environ["RESULT"] + ".tmp", "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False)'
    chown "$APP_USER:$APP_USER" "$result.tmp"
    mv -f "$result.tmp" "$result"       # бот заберёт файл и пришлёт итог (updater.py)
    [[ $status != failed ]]
}

main "$@"
exit
