[Unit]
Description=Telegram-бот живой очереди
After=network-online.target
Wants=network-online.target

[Service]
User=queuebot
Group=queuebot
WorkingDirectory=/opt/queue-bot
ExecStart=/opt/queue-bot/.venv/bin/python main.py
# База — в /var/lib/queue-bot (systemd создаёт папку сам), настройки — в /etc/queue-bot/env.
StateDirectory=queue-bot
StateDirectoryMode=0750
Environment=DB_PATH=/var/lib/queue-bot/queue.db PYTHONUNBUFFERED=1
EnvironmentFile=/etc/queue-bot/env
# Остановился (перезапуск, обновление, падение) — на это время дежурный отвечает «подождите» (deploy/maintenance.py).
# «+» — выполнить с правами root вне песочницы, «-» — сбой не мешает остановке. Когда бот снова опрашивает Telegram,
# дежурный получает 409 и сам уходит.
ExecStopPost=-+/bin/systemctl start --no-block queue-bot-maint.service
# Упал или пропал интернет — перезапуск через 10 секунд.
Restart=always
RestartSec=10

# Бот может писать только в свою папку с данными; код и система для него только на чтение.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
