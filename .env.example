# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID создателей через запятую (узнать свой — @userinfobot). Старая переменная ADMIN_IDS тоже работает.
# Создатель принимает заявки, назначает админов и старост и управляет всем; его нельзя снять из бота.
# Если пусто — заявки принимаются автоматически.
CREATOR_IDS=

# Путь к базе SQLite. На сервере (deploy/install.sh) база лежит в /opt/queue-bot/data/queue.db
DB_PATH=data/queue.db

# Часовой пояс для времени в журнале
TIMEZONE=Europe/Minsk

# Номер группы — только для имени файла копии базы (bd-513802-дд-мм-гггг-ччмм.zip)
# GROUP_NO=513802

# Веб-панель: порт (0 — выключить), адрес, на котором слушать, и публичный адрес для ссылок из бота.
# Снаружи открывай её только через HTTPS (обратный прокси или туннель), см. README.
# WEB_PORT=8080
# WEB_HOST=127.0.0.1
# WEB_URL=https://queue.example.com
# Кому можно входить в веб-панель: admin, starosta, user через запятую (по умолчанию — всем из списка группы)
# WEB_ROLES=admin,starosta,user

# Копии базы на другие серверы (необязательно). Копия шифруется до отправки; приёмник — deploy/receiver/queue-bot-receiver.py.
# Ключ: openssl rand -base64 32 (храни у себя отдельно — без него копию не расшифровать).
# BACKUP_KEY=
# BACKUP_TARGETS=[{"name":"home","url":"https://backup.example.com","token":"секрет-приёмника-латиницей","keep":14}]
# BACKUP_EVERY_HOURS=24
