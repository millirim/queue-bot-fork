# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID админов через запятую (узнать свой — @userinfobot).
# Админ принимает заявки, назначает старост и управляет всем. Если пусто — заявки принимаются автоматически.
ADMIN_IDS=

# Путь к базе SQLite. Локально можно оставить по умолчанию (data/queue.db).
# На сервере (deploy/install.sh) база лежит в /opt/queue-bot/data/queue.db
DB_PATH=data/queue.db

# Часовой пояс расписания
TIMEZONE=Europe/Minsk

# Правила очереди (необязательно)
# UNLOCK_BEFORE_HOURS=24
# UNLOCK_WARN_MINUTES=30
# SHUFFLE_BEFORE_MINUTES=60

# Границы семестра — нужны только если расписание берётся из xlsx (API недоступен)
# SEMESTER_START=2026-09-01
# SEMESTER_END=2026-12-28
